# Copy to .env and fill in. Never commit .env.
# EXPO_PUBLIC_* values are bundled into the app — they are NOT secret. Never put secret keys here.

# From `npx supabase start` (local) or the Supabase dashboard (staging/prod)
# iOS simulator (runs on your Mac, so 127.0.0.1 is your Mac):
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Real phone in Expo Go (same Wi-Fi): use your Mac's LAN IP, as shown in Metro's exp:// URL.
# Restart with `npx expo start -c` after changing it.
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.x.x:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps SDK key for Android map tiles (restricted to the app's package name). iOS uses Apple Maps.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# --- Server-side only (Supabase Edge Function secrets, set with `npx supabase secrets set`) ---
# PLACES_API_KEY=            # Places API (New), used only by the places-* Edge Functions
#   Never put it in this file or in any EXPO_PUBLIC_* value.
#   Local: put it in supabase/functions/.env (gitignored), then run `npx supabase functions serve`.
#   Production: `npx supabase secrets set PLACES_API_KEY=...` on the linked project (Archan only).
#   Tests and CI never need it; without it the functions still start and return 500 only when
#   Google would be called.
# REFRESH_CRON_SECRET=       # Spec 07: shared secret for the places-refresh Edge Function (pg_cron sends it
#                            # in the x-cron-secret header). A random string, e.g. `openssl rand -hex 32`.
#   Never put it in this file or in any EXPO_PUBLIC_* value. The same value is stored in the Supabase Vault
#   (places_refresh_secret) so the database can send it. Without it the function returns 500 not_configured.
#   Local: put it in supabase/functions/.env (gitignored) next to PLACES_API_KEY.
#   Production: `npx supabase secrets set REFRESH_CRON_SECRET=...` on the linked project (Archan only).

# --- Your shell profile (~/.zshrc), for Claude Code MCP servers — not this file ---
# GITHUB_PERSONAL_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
